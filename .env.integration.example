# Browser-visible configuration only. Never put client secrets or passwords here.
VITE_AUTH0_DOMAIN=moodly-test.example.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.test.moodly.example
VITE_API_BASE_URL=http://localhost:8080

# Playwright-only values belong in the process environment or an ignored
# .env.integration.local file once the E2E runner is introduced.
E2E_BASE_URL=http://localhost:4173
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_PASSWORD=
E2E_DATA_RESET_URL=
E2E_DATA_RESET_TOKEN=
