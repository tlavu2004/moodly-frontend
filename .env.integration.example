# Browser-visible configuration only. Never put client secrets or passwords here.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
VITE_API_BASE_URL=

# Playwright-only values belong in the process environment or the ignored
# .env.integration.local file. Leave E2E_BASE_URL unset for local runs so
# Playwright starts Vite at http://127.0.0.1:4173 automatically. Set it only
# when targeting an already-running frontend or a remote staging deployment.
# E2E_BASE_URL=https://staging.example.com
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_PASSWORD=
E2E_DATA_RESET_URL=
E2E_DATA_RESET_TOKEN=
