# Shared workstation configuration for local and test (Vite or Docker).
# Browser origin: http://127.0.0.1:5173. Production uses Vercel/CI configuration.
# Only these four public variables are embedded in the browser build.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
VITE_API_BASE_URL=

# Optional: required only for authenticated Playwright, never exposed to the browser.
# Use a dedicated synthetic account matching MOODLY_E2E_USER_ID in non-production BE.
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_PASSWORD=
E2E_DATA_RESET_URL=
E2E_DATA_RESET_TOKEN=
