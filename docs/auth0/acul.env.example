# Public packaging values; not browser secrets. Set in the build shell/CI.
ACUL_ASSET_BASE_URL=https://assets.YOUR_DOMAIN/acul/
ACUL_CLIENT_ID=YOUR_MOODLY_SPA_CLIENT_ID
# Auth0 custom domain must be configured in the tenant before FE/BE issuer cutover.
# Do not put an Auth0 Management API token in VITE_* variables.
