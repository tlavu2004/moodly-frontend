# Browser-visible configuration only. Never put client secrets or passwords here.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
VITE_API_BASE_URL=

# Playwright-only values belong in the process environment or the ignored
# .env.test.local file. E2E_TARGET=dev starts an owned test Vite server;
# E2E_TARGET=container uses an existing test image at 127.0.0.1:4173.
# E2E_TARGET=remote requires an explicit HTTPS E2E_BASE_URL.
# E2E_BASE_URL=https://test.example.com
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_PASSWORD=
E2E_DATA_RESET_URL=
E2E_DATA_RESET_TOKEN=

# Runner selects dev (owned Vite), container (existing Nginx) or remote (existing HTTPS).
# E2E_TARGET=dev
# E2E_BASE_URL=http://127.0.0.1:4173
# Authenticated runs require the BE protected test namespace contract.
E2E_NAMESPACE=
E2E_TEST_CONTRACT_URL=
# Never enable remote writes without authorization for that specific run.
# E2E_ALLOW_REMOTE_WRITES=1
